{
  "name": "capve",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "CLOUDFLARE_ENV=production bun run build && wrangler deploy --env production --var APP_URL:https://capve.app",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply velo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply velo-db --remote",
    "remove-access": "bun run scripts/remove-access.mjs"
  },
  "dependencies": {
    "hono": "^4.9.6",
    "jose": "^6.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.2",
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250826.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.0"
  }
}
